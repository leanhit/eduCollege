# ========================================
# DATABASE CONFIGURATION
# ========================================
DATABASE_URL=jdbc:postgresql://localhost:5432/educollege_db
DATABASE_USER=educollege_user
DATABASE_PASSWORD=your_strong_password_here_change_me

# ========================================
# SECURITY CONFIGURATION
# ========================================
JWT_SECRET=your_64_character_random_jwt_secret_key_here_minimum_length_change_me

# ========================================
# INFRASTRUCTURE CONFIGURATION
# ========================================
# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password_here_change_me

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_password_here_change_me
MINIO_BUCKET=educollege-files

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here_change_me

# ========================================
# PRODUCTION DOMAINS & CORS
# ========================================
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ========================================
# PRODUCTION SETTINGS
# ========================================
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
LOG_LEVEL=WARN
DEBUG=false

# ========================================
# MONITORING
# ========================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true
